# --- Core ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (docker-compose defaults) ---
# Runtime user: app_runtime — non-owner, NOBYPASSRLS. All app queries run as this role.
DATABASE_URL="postgresql://app_runtime:runtime_dev_password@localhost:5432/cathaid?connection_limit=20"
# Owner user: migrations only (prisma.config.ts / prisma migrate).
DIRECT_DATABASE_URL="postgresql://cathaid_owner:owner_dev_password@localhost:5432/cathaid"

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# HS256 dev secret for our own access JWTs (RS256 + JWKS in prod).
AUTH_JWT_SECRET=dev-only-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Dev token issuer (POST /api/v1/auth/dev-token). Refused when NODE_ENV=production.
AUTH_DEV_MODE=true

# --- Object storage (MinIO in dev; S3 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=cathaid-media
S3_BUCKET_CHAT=cathaid-chat
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- EHR / Epic sandbox (M6) ---
EPIC_SANDBOX_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_SANDBOX_FHIR_BASE=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EHR_EPIC_CLIENT_ID=
EHR_JWT_PRIVATE_KEY_REF=
EHR_JWKS_KID=cathaid-2026-01
EHR_FETCH_TIMEOUT_MS=4000

# --- AI (M7/M8) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AI_VOICE_MAX_ATTEMPTS=2
# AI features stay disabled in production until vendor BAAs are executed.
PHI_VENDORS_BAA_CONFIRMED=false

# --- Chat (fallbacks; the pinned workflow JSON wins) ---
CHAT_SEND_WINDOW_ACTIVE_DAYS=7
CHAT_SEND_WINDOW_TERMINAL_DAYS=2
SHADOW_DATABASE_URL="postgresql://cathaid_owner:owner_dev_password@localhost:5432/cathaid_shadow"
KEYCLOAK_DEV_CLIENT_SECRET=cathaid-dev-secret
